<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TT_Final_Status_Locked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Verification_Status__c), 
    OR(ISPICKVAL(PRIORVALUE(Verification_Status__c), &apos;Approved&apos;), 
       ISPICKVAL(PRIORVALUE(Verification_Status__c), &apos;Rejected&apos;)))</errorConditionFormula>
    <errorMessage>This request has already been finalized (Approved or Rejected) and cannot be changed.</errorMessage>
</ValidationRule>
