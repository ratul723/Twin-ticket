<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TT_Approve_Needs_Complete</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Verification_Status__c), 
    ISPICKVAL(Verification_Status__c, &apos;Approved&apos;), 
    NOT(Submission_Complete__c))</errorConditionFormula>
    <errorMessage>Review notes are required when making a decision (Approved or Rejected).</errorMessage>
</ValidationRule>
